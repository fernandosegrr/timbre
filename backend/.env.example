# Puerto en el que escucha el servidor (EasyPanel puede sobreescribirlo)
PORT=3000

# ---- Supabase (base de datos) ----
# URL del proyecto, ej: https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) - acceso total, SOLO server-side. Nunca pongas
# aquí la publishable key (esta app no la necesita).
SUPABASE_SECRET_KEY=

# ---- Panel admin (HTTP Basic Auth) ----
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto-por-algo-seguro

# ---- Secreto compartido con el ESP32 ----
# El ESP32 manda este mismo valor en el header X-Device-Secret.
DEVICE_SHARED_SECRET=cambia-esto-tambien

# ---- WhatsApp Cloud API ----
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=aviso_timbre
WHATSAPP_TEMPLATE_LANG=es_MX
# Solo se usa para correr scripts/crear-plantilla-whatsapp.js una vez
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- Web Push (PWA) ----
# Generar una sola vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
